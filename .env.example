# Blog feed configuration

# Medium RSS feed (full URL or username)
MEDIUM_USERNAME=seeurity
MEDIUM_FEED=https://medium.com/feed/@seeurity

# Hashnode publication host
HASHNODE_HOST=seeurity.hashnode.dev

# Optional: Hashnode Personal Access Token for GraphQL API (Pro plan)
# Without this, Hashnode falls back to RSS automatically.
HASHNODE_PAT=

# Phone OTP (Vercel /api/send-otp, /api/verify-otp)
OTP_SECRET=change-me-in-production

# Optional: Twilio for real SMS OTP
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# Frontend mirrors (Vite)
VITE_MEDIUM_USERNAME=seeurity
VITE_HASHNODE_HOST=seeurity.hashnode.dev
