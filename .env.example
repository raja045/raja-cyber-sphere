# Blog feed configuration
# Copy these to your .env file and set your actual Medium username.

# Your Medium handle WITHOUT the @ symbol
# Find it in your profile URL: https://medium.com/@YOUR_USERNAME
VITE_MEDIUM_USERNAME=nakamotosecurity

# Optional: override the RSS URL directly (publication or custom domain feeds)
# Examples:
#   https://medium.com/feed/@your-username
#   https://your-username.medium.com/feed
#   https://medium.com/feed/your-publication-name
VITE_MEDIUM_RSS_URL=

# Hashnode publication host
VITE_HASHNODE_HOST=toxsec.hashnode.dev

# Server-side only (for `server/index.js` and Supabase edge function)
MEDIUM_USERNAME=nakamotosecurity
MEDIUM_RSS_URL=
HASHNODE_HOST=toxsec.hashnode.dev

# Optional fallback if Medium blocks direct RSS fetches
# Free tier: https://rss2json.com (10,000 requests/day)
RSS2JSON_API_KEY=
